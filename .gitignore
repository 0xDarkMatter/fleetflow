# Python bytecode (ff-serve.py)
__pycache__/
*.pyc

# Claude Code session state (this repo is also mounted as a live skill)
.claude/

# fleetflow run dirs — runs belong to the TARGET repo's .fleetflow/, but guard
# against an accidental fleet launched with this repo as cwd
.fleetflow/
.claude/fleet/
.fleet-worktrees/

# Impeccable design-lint local state (waivers stay machine-local by preference)
.impeccable/
